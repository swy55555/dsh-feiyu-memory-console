{
  "name": "dsh-feiyu-memory-console",
  "version": "0.10.0",
  "private": false,
  "description": "心迹：基于经历、可塑记忆与当前心绪的陪伴系统，保留 QQ 通信和二代仿真兼容能力。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swy55555/dsh-feiyu-memory-console.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync:memvec": "node scripts/sync-memvec.mjs",
    "start": "node bin/preview.mjs",
    "doctor": "node bin/doctor.mjs",
    "start:memvec": "node bin/start-memvec.mjs",
    "test": "node test/run.mjs",
    "test:browser": "node test/browser.test.mjs",
    "test:browser:context": "node test/context-browser.test.mjs",
    "simulate:emotion": "node scripts/simulate-emotion.mjs",
    "test:browser:usage": "node test/usage-association-browser.test.mjs",
    "test:browser:continuity": "node test/continuity-browser.test.mjs",
    "simulate:continuity": "node scripts/simulate-continuity.mjs",
    "test:browser:ui": "node test/ui-upgrade-browser.test.mjs",
    "simulate:mind": "node scripts/simulate-mind.mjs",
    "test:browser:mind": "node test/mind-browser.test.mjs",
    "test:browser:light": "node test/light-browser.test.mjs",
    "simulate:everyday": "node scripts/simulate-everyday.mjs",
    "check:engine": "node bridge/xinji-engine.mjs --check"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bridge",
    "docs",
    "web",
    "bin",
    "locale",
    "memvec",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "ACKNOWLEDGEMENTS.md",
    "DISCLAIMER.md",
    "CHANGELOG.md",
    "LICENSE",
    "test",
    "UPGRADE.md",
    "manual/USER_GUIDE-0.10.0.md",
    "manual/USER_GUIDE-0.10.0.pdf"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  }
}
