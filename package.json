{
  "name": "dsh-feiyu-memory-console",
  "version": "0.8.4",
  "private": false,
  "description": "可塑性记忆：查看和维护 QQ 角色的长期记忆、日记、性格与情绪；本地优先，支持审计和撤销。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swy55555/dsh-feiyu-memory-console.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync:memvec": "node scripts/sync-memvec.mjs",
    "start": "node bin/preview.mjs",
    "doctor": "node bin/doctor.mjs",
    "start:memvec": "node bin/start-memvec.mjs",
    "test": "node test/run.mjs",
    "test:browser": "node test/browser.test.mjs"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bridge",
    "docs",
    "web",
    "bin",
    "locale",
    "memvec",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "ACKNOWLEDGEMENTS.md",
    "DISCLAIMER.md",
    "CHANGELOG.md",
    "LICENSE",
    "test",
    "UPGRADE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  }
}